# Copy to .env.local (or .env.development.local) and fill in. Both values are public by design.
# The local stack prints them: run `supabase status` in site/ and use "API URL" and the anon key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Leave unset for real Discord sign-in. Local builds (dev server, build:dev) get "dev" from .env.dev.
# VITE_AUTH_MODE=dev
