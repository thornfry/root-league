{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Vite fingerprints assets; missing assets must never return the SPA HTML.
	handle /assets/* {
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Other file requests (including unknown extensions) also get a real 404.
	@file path_regexp extension \.[^/]+$
	handle @file {
		header Cache-Control "no-cache"
		file_server
	}

	# Browser-history routes and HTML revalidate after each deployment.
	handle {
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
